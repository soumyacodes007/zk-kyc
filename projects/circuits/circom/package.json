{
    "name": "algokyc-circuits",
    "version": "1.0.0",
    "description": "AlgoKYC Circom ZK circuit — in-browser PLONK proof generation via snarkjs",
    "scripts": {
        "install-deps": "npm install",
        "compile": "circom circuits/kyc.circom --r1cs --wasm --sym --output build/",
        "setup": "node scripts/setup.js",
        "prove": "node scripts/prove.js",
        "verify": "node scripts/verify.js",
        "export-verifier": "node scripts/export_verifier.js",
        "test": "node test/test_circuit.js"
    },
    "dependencies": {
        "circomlib": "^2.0.5",
        "snarkjs": "^0.7.4",
        "ffjavascript": "^0.3.0"
    }
}