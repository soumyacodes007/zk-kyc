// smart_contracts.kyc_verifier.contract.expmod(base: bytes, exponent: bytes, modulus: bytes) -> bytes:
expmod:
    // smart_contracts/kyc_verifier/contract.py:331-332
    // @subroutine
    // def expmod(base: BigUInt, exponent: BigUInt, modulus: BigUInt) -> BigUInt:
    proto 3 1
    // smart_contracts/kyc_verifier/contract.py:334
    // result = BigUInt(1)
    bytec_1 // 0x01

expmod_while_top@1:
    // smart_contracts/kyc_verifier/contract.py:335
    // while exponent > 0:
    frame_dig -2
    bytec_2 // 0x
    b>
    bz expmod_after_while@5
    // smart_contracts/kyc_verifier/contract.py:336
    // if exponent % 2 == 1:
    frame_dig -2
    pushbytes 0x02
    b%
    bytec_1 // 0x01
    b==
    bz expmod_after_if_else@4
    // smart_contracts/kyc_verifier/contract.py:337
    // result = (result * base) % modulus
    frame_dig 0
    frame_dig -3
    b*
    frame_dig -1
    b%
    frame_bury 0

expmod_after_if_else@4:
    // smart_contracts/kyc_verifier/contract.py:338
    // exponent = exponent // 2
    frame_dig -2
    pushbytes 0x02
    b/
    frame_bury -2
    // smart_contracts/kyc_verifier/contract.py:339
    // base = (base * base) % modulus
    frame_dig -3
    dup
    b*
    frame_dig -1
    b%
    frame_bury -3
    b expmod_while_top@1

expmod_after_while@5:
    // smart_contracts/kyc_verifier/contract.py:340
    // return result
    frame_dig 0
    swap
    retsub


// smart_contracts.kyc_verifier.contract.invert(p: bytes) -> bytes:
invert:
    // smart_contracts/kyc_verifier/contract.py:347-348
    // @subroutine
    // def invert(p : Bytes) -> Bytes:
    proto 1 1
    // smart_contracts/kyc_verifier/contract.py:350
    // x = BigUInt.from_bytes(p[:32])
    frame_dig -1
    len
    intc_0 // 32
    dig 1
    >=
    intc_0 // 32
    dig 2
    uncover 2
    select
    frame_dig -1
    intc_1 // 0
    dig 2
    substring3
    // smart_contracts/kyc_verifier/contract.py:351
    // y = BigUInt.from_bytes(p[32:])
    frame_dig -1
    uncover 2
    uncover 3
    substring3
    // smart_contracts/kyc_verifier/contract.py:352
    // neg_y = BigUInt(P_MOD) - y
    pushbytes 0x30644e72e131a029b85045b68181585d97816a916871ca8d3c208c16d87cfd47
    swap
    b-
    // smart_contracts/kyc_verifier/contract.py:353
    // return x.bytes + UInt256(neg_y).bytes
    dup
    len
    intc_0 // 32
    <=
    assert // overflow
    intc_0 // 32
    bzero
    b|
    concat
    retsub
