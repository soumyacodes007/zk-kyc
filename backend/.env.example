# AlgoKYC Backend — Environment Variables
# Copy to .env and fill in your values

# ── Algorand ──────────────────────────────────────────
ALGOD_SERVER=https://testnet-api.algonode.cloud
ALGOD_TOKEN=

# Issuer wallet — MUST be the deployer of NullifierRegistry
DEPLOYER_MNEMONIC=your twenty five word mnemonic phrase here fill this in

# ── Deployed Contract IDs (Algorand Testnet) ──────────
NULLIFIER_REGISTRY_ID=756272073
SMT_REGISTRY_ID=756272075
KYC_BOX_STORAGE_ID=756272299
CREDENTIAL_MANAGER_ID=756281076
CREDENTIAL_ASA_ID=756281102

# ── ZK Verification ───────────────────────────────────
# Path to verification_key.json (from circom trusted setup)
VERIFICATION_KEY_PATH=../projects/circuits/circom/build/verification_key.json

# ── Security ──────────────────────────────────────────
# Change in production! Used to sign court order requests.
API_SECRET_KEY=algokyc-dev-secret-change-in-production

# ── ECIES ─────────────────────────────────────────────
# Issuer's secp256k1 private key hex (32 bytes = 64 hex chars)
# For dev: generate with: python -c "import os; print(os.urandom(32).hex())"
ISSUER_PRIVATE_KEY_HEX=

# ── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://algokyc.app
